# MedWaste Smart — Environment Variables
# Copy this file to .env and fill in your values.
# The hackathon demo runs entirely on localStorage mocks (no backend needed).

# Set to "false" to enable real Firebase auth/firestore. Leave unset for mock mode.
VITE_USE_MOCK_DATA=true

# Firebase configuration (only needed when VITE_USE_MOCK_DATA=false)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Vite
VITE_HOST=127.0.0.1
VITE_PORT=5173
